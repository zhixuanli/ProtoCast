{
  "method": "ProtoCast",
  "variant": "entmax",
  "benchmark": "GlobalForecast",
  "seed": 42,
  "data": {
    "variables": [
      "u10",
      "v10",
      "t2m",
      "tcc",
      "r"
    ],
