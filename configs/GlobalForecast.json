      "u10",
      "v10",
      "t2m",
      "tcc",
      "r"
    ],
    "height": 32,
    "width": 64,
    "input_steps": 12,
    "output_steps": 12,
    "step_hours": 1,
    "normalization": "train_stats.json",
    "splits": {
      "train": [
        2010,
        2015
      ],
      "val": [
        2016,
        2016
      ],
      "test": [
        2017,
        2018
      ]
    },
    "metric_groups": {
      "uv10": [
        "u10",
        "v10"
      ]
    }
  },
  "model": {
